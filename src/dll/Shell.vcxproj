      <ProgramDatabaseFile>$(OutDir)$(TargetName)$(TargetExt).pdb</ProgramDatabaseFile>
      <ProfileGuidedDatabase>$(OutDir)$(TargetName)$(TargetExt).pgd</ProfileGuidedDatabase>
      <AdditionalDependencies>kernel32.lib;user32.lib;gdi32.lib;advapi32.lib;shell32.lib;ole32.lib</AdditionalDependencies>
    </Link>
    <ResourceCompile>
      <Culture>0x0409</Culture>
      <PreprocessorDefinitions>_WINDLL;_WIN64;_UNICODE;UNICODE;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ResourceCompile>
    <Xdcmake>
      <OutputFile>$(OutDir)$(TargetName)$(TargetExt).xml</OutputFile>
    </Xdcmake>
    <Bscmake>
      <OutputFile>$(OutDir)$(TargetName)$(TargetExt).bsc</OutputFile>
    </Bscmake>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)'=='release'">
    <ClCompile>
      <IntrinsicFunctions>true</IntrinsicFunctions>
      <PreprocessorDefinitions>NDEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <RuntimeLibrary>MultiThreaded</RuntimeLibrary>
      <!-- Symbols are needed to make a crash report actionable. The .pdb is a
           side file, is not referenced by the installer, and does not change
           the shipped image. -->
      <DebugInformationFormat>ProgramDatabase</DebugInformationFormat>
      <!-- /GL. The Configuration property group already asks for whole program
           optimisation; this used to switch it back off for every file, so it
           was never actually on. -->
      <WholeProgramOptimization>$(ShellEnableLTCG)</WholeProgramOptimization>
      <FavorSizeOrSpeed>Speed</FavorSizeOrSpeed>
      <Optimization>MaxSpeed</Optimization>
      <EnableModules>false</EnableModules>
      <CreateHotpatchableImage>false</CreateHotpatchableImage>
    </ClCompile>
    <Link>
      <EnableCOMDATFolding>true</EnableCOMDATFolding>
      <OptimizeReferences>true</OptimizeReferences>
      <GenerateDebugInformation>true</GenerateDebugInformation>
      <!-- /LTCG. Enabled once the VM smoke test existed to catch a miscompile:
           this image is injected into Explorer, so "it linked" is not evidence
           that it works. Validated by opening a real context menu and reading
           the items back out of it. -->
      <LinkTimeCodeGeneration Condition="'$(ShellEnableLTCG)'=='true'">UseLinkTimeCodeGeneration</LinkTimeCodeGeneration>
      <LinkTimeCodeGeneration Condition="'$(ShellEnableLTCG)'!='true'">Default</LinkTimeCodeGeneration>
      <IgnoreEmbeddedIDL>true</IgnoreEmbeddedIDL>
      <AdditionalOptions>/EMITPOGOPHASEINFO</AdditionalOptions>
      <!-- This DLL is mapped into every process that shows a context menu, so
           every hard import is resolved N times over. propsys is not touched
           from DllMain; it is only reached from expression evaluation. uxtheme,
           dwmapi and comctl32 are deliberately left as hard imports; comctl32
           in particular interacts with the activation context.

           d2d1, dwrite and winmm used to be listed here. They are not any more:
           the Direct2D renderer and the vblank sleep in the menu code that
           needed them are gone, so none of the three is imported at all now.
           winmm's only three symbols in the whole product (timeGetDevCaps,
           timeBeginPeriod, timeEndPeriod) lived in that one function. Leaving a
           delay-load entry for a DLL with no imports makes the linker emit
           LNK4199. -->
      <DelayLoadDLLs>propsys.dll;%(DelayLoadDLLs)</DelayLoadDLLs>
      <SetChecksum>true</SetChecksum>
      <IgnoreSpecificDefaultLibraries />
      <ImageHasSafeExceptionHandlers />
    </Link>
    <Xdcmake>
      <SuppressStartupBanner Condition="'$(Configuration)|$(Platform)'=='release|x64'">false</SuppressStartupBanner>
    </Xdcmake>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Platform)'=='ARM64'">
    <Link>
      <MinimumRequiredVersion>10.0</MinimumRequiredVersion>
    </Link>
  </ItemDefinitionGroup>
